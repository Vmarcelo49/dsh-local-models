{
  "name": "dsh-local-models",
  "version": "0.3.1",
  "description": "dsh addon: a Local Models settings tab that starts and stops a llama-server child process living with the dsh host process.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "test": "node --test test/",
    "audit": "node skills/dsh-local-models-ops/scripts/audit-profiles.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llama.cpp",
    "llama-server",
    "gguf",
    "local-models"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vmarcelo49/dsh-local-models.git"
  },
  "homepage": "https://github.com/Vmarcelo49/dsh-local-models#readme",
  "bugs": {
    "url": "https://github.com/Vmarcelo49/dsh-local-models/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "README-pt.md",
    "README-es.md",
    "README-zh.md",
    "README-hi.md"
  ],
  "license": "MIT"
}
